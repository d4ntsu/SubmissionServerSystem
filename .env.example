# Python backend
APP_ENVIRONMENT=development
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_SESSION_DAYS=14
# HTTP development only. Set to true when deploying behind HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Database
DATABASE_URL=sqlite:///./data/exam_system.db

# Piston execution service (keep Piston bound to localhost)
PISTON_BASE_URL=http://127.0.0.1:2000
PISTON_REQUEST_TIMEOUT_SECONDS=20
PISTON_COMPILE_TIMEOUT_MS=10000
PISTON_RUN_TIMEOUT_MS=3000
PISTON_COMPILE_MEMORY_LIMIT_BYTES=536870912
PISTON_RUN_MEMORY_LIMIT_BYTES=268435456

# Java Socket Server
SOCKET_SERVER_HOST=127.0.0.1
SOCKET_SERVER_PORT=9000
SOCKET_SERVER_SHARED_SECRET=

# CORS (explicit comma-separated origins; do not use wildcard origins with credentials)
CORS_ORIGINS=http://localhost:3000

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/realtime
