# Python backend
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./data/exam_system.db

# Piston execution service (keep Piston bound to localhost)
PISTON_BASE_URL=http://127.0.0.1:2000
PISTON_REQUEST_TIMEOUT_SECONDS=20
PISTON_COMPILE_TIMEOUT_MS=10000
PISTON_RUN_TIMEOUT_MS=3000
PISTON_COMPILE_MEMORY_LIMIT_BYTES=536870912
PISTON_RUN_MEMORY_LIMIT_BYTES=268435456

# Java Socket Server
SOCKET_SERVER_HOST=127.0.0.1
SOCKET_SERVER_PORT=9000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/realtime
