# Python backend
APP_ENVIRONMENT=development
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_SESSION_DAYS=14
# HTTP development only. Set to true when deploying behind HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Database
DATABASE_URL=sqlite:///./data/exam_system.db

# Java Socket Server
SOCKET_SERVER_HOST=127.0.0.1
SOCKET_SERVER_PORT=9000
SOCKET_SERVER_SHARED_SECRET=

# CORS (explicit comma-separated origins; do not use wildcard origins with credentials)
CORS_ORIGINS=http://localhost:3000

# Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/realtime
